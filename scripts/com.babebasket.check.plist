<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs `check` every minute inside the logged-in GUI session (not over SSH), so Chrome can
     read the login keychain for the Gemini profile. Install: scripts/install_check_agent.sh -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.babebasket.check</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__ROOT__/scripts/run.sh</string><string>check</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>__ROOT__/data/logs/launchd-check.out</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/logs/launchd-check.err</string>
</dict>
</plist>
