# Copy to .env (never commit .env).
OPENROUTER_API_KEY=sk-or-...
DISCORD_BOT_TOKEN=...
# Optional: overrides [discord].channel_id in config.toml
# DISCORD_CHANNEL_ID=123456789012345678

# Threads posting (developers.facebook.com app -> Threads API -> User Token Generator)
THREADS_ACCESS_TOKEN=

# Instagram (Creator/Business account). Either its own token from "Instagram API with Instagram Login"
# (no Facebook Page needed) ...
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# ... or, when also posting to a Facebook Page, a long-lived Page token (Instagram linked to that Page).
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
